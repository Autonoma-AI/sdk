generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String        @id
  name         String
  testRunId    String?
  users        User[]
  applications Application[]
}

model User {
  id             String       @id
  email          String
  testRunId      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Application {
  id             String       @id
  name           String
  testRunId      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}
