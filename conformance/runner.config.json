{
  "version": 1,
  "modules": ["graph", "template", "hmac", "refs", "fingerprint"],
  "bridges": {
    "typescript": {
      "command": "npx",
      "args": ["tsx", "bridges/typescript.ts"],
      "cwd": "."
    },
    "elixir": {
      "command": "mix",
      "args": ["run", "bridges/conformance_bridge.exs"],
      "cwd": "../sdks/elixir"
    },
    "python": {
      "command": "python3",
      "args": ["bridges/conformance_bridge.py"],
      "cwd": "../sdks/python"
    },
    "java": {
      "command": "java",
      "args": ["-jar", "conformance-bridge/target/autonoma-conformance-bridge-0.1.0.jar"],
      "cwd": "../sdks/java"
    },
    "ruby": {
      "command": "ruby",
      "args": ["-Ilib", "bridges/conformance_bridge.rb"],
      "cwd": "../sdks/ruby"
    }
  }
}
