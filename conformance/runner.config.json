{
  "version": 1,
  "_comment": "`modules` is the default suite for unmigrated (v1) languages, which still ship graph + fingerprint. Scenario-v2 languages override it per bridge with `modules`: they dropped the create-graph interpreter and fingerprint(), so they only conform on the unchanged hmac + refs primitives.",
  "modules": ["graph", "hmac", "refs", "fingerprint"],
  "bridges": {
    "typescript": {
      "command": "npx",
      "args": ["tsx", "bridges/typescript.ts"],
      "cwd": ".",
      "modules": ["hmac", "refs"]
    },
    "python": {
      "command": "python3",
      "args": ["bridges/conformance_bridge.py"],
      "cwd": "../sdks/python",
      "modules": ["hmac", "refs"]
    },
    "go": {
      "command": "./bridges/conformance_bridge",
      "args": [],
      "cwd": "../sdks/go",
      "modules": ["hmac", "refs"]
    },
    "rust": {
      "command": "../sdks/rust/target/release/conformance_bridge",
      "args": [],
      "cwd": ".",
      "modules": ["hmac", "refs"]
    }
  }
}
