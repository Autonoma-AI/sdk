{
  "name": "up runs a scenario and returns the envelope",
  "steps": [
    {
      "action": "discover",
      "expect": { "status": 200 },
      "saveAs": "discoverResult"
    },
    {
      "action": "up",
      "body": {
        "scenario": { "name": "{{discoverResult.scenarios[0].name}}" },
        "testRunId": "protocol-run-1"
      },
      "expect": {
        "status": 200,
        "bodyShape": {
          "teardownToken": "string",
          "refs": "undefined",
          "refsToken": "undefined"
        },
        "bodyAssertions": [
          { "path": "version", "type": "string", "pattern": "^2\\.0$" },
          { "path": "teardownToken", "type": "string", "notEmpty": true },
          { "path": "expiresInSeconds", "type": "number" }
        ]
      },
      "saveAs": "upResult"
    }
  ]
}
