{
  "name": "error handling for invalid requests",
  "steps": [
    {
      "action": "nonexistent",
      "expect": {
        "status": 400,
        "body": { "code": "UNKNOWN_ACTION" }
      }
    },
    {
      "action": "up",
      "body": { "scenario": { "name": "does-not-exist" }, "testRunId": "protocol-run-err" },
      "expect": {
        "status": 400,
        "body": { "code": "UNKNOWN_ENVIRONMENT" }
      }
    }
  ]
}
