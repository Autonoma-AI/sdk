{
  "name": "down tears a scenario down with a valid teardownToken",
  "steps": [
    {
      "action": "discover",
      "expect": { "status": 200 },
      "saveAs": "discoverResult"
    },
    {
      "action": "up",
      "body": {
        "scenario": { "name": "{{discoverResult.scenarios[0].name}}" },
        "testRunId": "protocol-run-2"
      },
      "expect": { "status": 200 },
      "saveAs": "upResult"
    },
    {
      "action": "down",
      "body": {
        "teardownToken": "{{upResult.teardownToken}}",
        "testRunId": "protocol-run-2"
      },
      "expect": {
        "status": 200,
        "body": { "ok": true },
        "bodyAssertions": [
          { "path": "version", "type": "string", "pattern": "^2\\.0$" }
        ]
      }
    }
  ]
}
