{
  "name": "discover lists registered scenarios",
  "steps": [
    {
      "action": "discover",
      "expect": {
        "status": 200,
        "bodyShape": {
          "scenarios": "array"
        },
        "bodyAssertions": [
          { "path": "version", "type": "string", "pattern": "^2\\.0$" },
          { "path": "scenarios[0].name", "type": "string", "notEmpty": true },
          { "path": "scenarios[0].description", "type": "string" }
        ]
      }
    }
  ]
}
