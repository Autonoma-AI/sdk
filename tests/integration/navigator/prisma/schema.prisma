generator client {
  provider     = "prisma-client-js"
  output       = "../generated"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String                @id @default(cuid())
  name                   String
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  communicationChannel   CommunciationChannel? @map("communication_channel")
  communicationChannelID String?               @map("communication_channel_id")
  organizationQuotaId    String?               @unique @map("quota_id")
  teamSlugs              String[]              @default([]) @map("team_slugs")

  /// [OrganizationConfiguration]
  orgConfiguration        Json                     @default("{}") @map("org_configuration") @db.Json
  domain                  String?                  @unique
  workosId                String?                  @unique @map("workos_id")
  APIKey                  ApiKey[]
  Application             Application[]
  applicationVersions     ApplicationVersion[]
  folders                 Folder[]
  FolderCache             FolderCache?
  integrations            Integration[]
  runs                    Run[]
  scripts                 Script[]
  TagInTestGroup          TagInTestGroup[]
  teams                   Team[]
  Tag                     Tag[]
  tests                   Test[]
  testGroups              TestGroup[]
  uploadedFiles           UploadedFile[]
  users                   User[]
  variables               Variable[]
  Webhook                 Webhook[]
  WebhookDelivery         WebhookDelivery[]
  notifications           Notification[]
  installations           VercelInstallation[]
  vercelSSOLinks          VercelSSOLink[]
  organizationQuota       OrganizationQuota?
  appMirrorPairs          AppMirrorPair[]
  archivedTests           ArchivedTest[]
  stickinessEmails        StickinessEmail[]
  components              Component[]
  componentVersions       ComponentVersion[]
  stepSequences              StepSequence[]
  deviceFarmConfiguration    DeviceFarmConfiguration?
  aiUsage                    AiUsage[]
  pendingPhysicalDeviceFiles PendingPhysicalDeviceFile[]
  accessibilityReports       AccessibilityReport[]

  @@index([workosId])
  @@map("organization")
}

model OrganizationQuota {
  id             String @id @default(cuid())
  organizationId String @unique @map("organization_id")

  active        Boolean @default(true)
  unlimited     Boolean @default(false) @map("unlimited")
  runsLeft      Int     @default(0) @map("runs_left")
  purchasedRuns Int     @default(0) @map("purchased_runs")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("organization_quota")
}

model DeviceFarmConfiguration {
  id                      String   @id @default(cuid())
  organizationId          String   @unique @map("organization_id")
  projectArn              String?  @map("project_arn")
  defaultAndroidDeviceArn String?  @map("default_android_device_arn")
  defaultIOSDeviceArn     String?  @map("default_ios_device_arn")
  region                  String   @default("us-west-2")
  pricePerMinute          Float?   @map("price_per_minute")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("device_farm_configuration")
}

model DeviceFarmBilling {
  id               String   @id @default(cuid())
  runID            String   @unique @map("run_id")
  sessionArn       String   @map("session_arn")
  billingMethod    String   @map("billing_method")
  totalMinutes     Float?   @map("total_minutes")
  meteredMinutes   Float?   @map("metered_minutes")
  unmeteredMinutes Float?   @map("unmetered_minutes")
  pricePerMinute   Float?   @map("price_per_minute")
  createdAt        DateTime @default(now()) @map("created_at")

  run Run @relation(fields: [runID], references: [id], onDelete: Cascade)

  @@map("device_farm_billing")
}

model Application {
  id                  String                    @id @default(cuid())
  name                String
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  applicationType     ApplicationType           @map("application_type")
  organizationId      String                    @map("organization_id")
  /// [ApplicationMetadata]
  applicationMetadata Json                      @map("application_metadata")
  organization        Organization              @relation(fields: [organizationId], references: [id])
  /// [AppConfiguration]
  appConfiguration    Json                      @default("{}") @map("app_configuration") @db.Json
  applicationVersions        ApplicationVersion[]
  testGroups                 TestGroup[]
  components                 Component[]
  vercelConnections          VercelProjectConnection[]
  tag                        Tag?
  mirrorPairsA               AppMirrorPair[]              @relation("AppMirrorPairA")
  mirrorPairsB               AppMirrorPair[]              @relation("AppMirrorPairB")
  pendingPhysicalDeviceFiles PendingPhysicalDeviceFile[]

  @@index([organizationId])
  @@map("application")
}

model ApplicationVersion {
  id                          String                       @id @default(cuid())
  name                        String
  createdAt                   DateTime                     @default(now()) @map("created_at")
  organizationID              String                       @map("organization_id")
  /// [ApplicationVersionConfiguration]
  configuration               Json?                        @db.Json
  tag                         VersionTag                   @default(main)
  path                        String
  physicalDevicePath          String?                      @map("physical_device_path")
  minimumIOSVersion           String?                      @map("minimum_ios_version")
  applicationID               String
  disabled                    Boolean                      @default(false)
  customID                    String?                      @map("custom_id")
  deviceFarmUploadArn         String?                      @map("device_farm_upload_arn")
  application                 Application                  @relation(fields: [applicationID], references: [id], onDelete: Cascade)
  organization                Organization                 @relation(fields: [organizationID], references: [id])
  test                        Test[]
  vercelTargets               VercelTargetMapping[]
  versionAssignments          VersionAssignment[]
  componentVersionAssignments ComponentVersionAssignment[]

  @@index([organizationID])
  @@index([applicationID], map: "application_version_application_id_idx")
  @@index([customID], map: "application_version_custom_id_idx")
  @@map("application_version")
}

model PendingPhysicalDeviceFile {
  id                 String   @id @default(cuid())
  applicationID      String   @map("application_id")
  organizationID     String   @map("organization_id")
  versionName        String?  @map("version_name")
  customID           String?  @map("custom_id")
  physicalDevicePath String   @map("physical_device_path")
  minimumIOSVersion  String?  @map("minimum_ios_version")
  createdAt          DateTime @default(now()) @map("created_at")

  application  Application  @relation(fields: [applicationID], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationID], references: [id])

  @@unique([applicationID, versionName])
  @@unique([applicationID, customID])
  @@index([organizationID])
  @@map("pending_physical_device_file")
}

enum TestType {
  final
  draft
  edit
}

model Test {
  id                   String              @id @default(cuid())
  name                 String
  metadata             Json
  architecture         Architecture
  target               Json?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  organizationID       String              @map("organization_id")
  crontab              String?
  folderID             String?             @map("folder_id")
  runOrder             Int?                @map("run_order")
  applicationVersionID String              @map("application_version_id")
  testGroupid          String
  parentTestID         String?             @map("parent_test_id")
  type                 TestType            @default(final) @map("type")
  userID               String?             @map("user_id")
  runs                 Run[]
  applicationVersion   ApplicationVersion  @relation(fields: [applicationVersionID], references: [id])
  folder               Folder?             @relation(fields: [folderID], references: [id], onDelete: Cascade)
  organization         Organization        @relation(fields: [organizationID], references: [id])
  parentTest           Test?               @relation("EditTests", fields: [parentTestID], references: [id], onDelete: Cascade)
  editTests            Test[]              @relation("EditTests")
  testGroup            TestGroup           @relation("ParentTestGroup", fields: [testGroupid], references: [id], onDelete: Cascade)
  user                 User?               @relation(fields: [userID], references: [id])
  webhookMetadata      Json?               @map("webhook_metadata")
  /// [TestConfiguration]
  testConfiguration    Json                @default("{}") @map("test_configuration") @db.Json
  versionAssignments   VersionAssignment[]
  mirrorPairsA         TestMirrorPair[]    @relation("MirrorTestA")
  mirrorPairsB         TestMirrorPair[]    @relation("MirrorTestB")

  defaultInTestGroup TestGroup[] @relation("DefaultTest")
  editHistory        TestEdit[]

  @@index([organizationID])
  @@index([folderID])
  @@index([applicationVersionID])
  @@index([testGroupid], map: "test_test_groupid_idx")
  @@index([name])
  @@index([name, organizationID])
  @@index([createdAt])
  @@index([type, userID])
  @@map("test")
}

model TestEdit {
  id       String   @id @default(cuid())
  testID   String   @map("test_id")
  userID   String   @map("user_id")
  editedAt DateTime @default(now()) @map("edited_at")
  test     Test     @relation(fields: [testID], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userID], references: [id])

  @@index([testID])
  @@index([userID])
  @@map("test_edit")
}

model ArchivedTest {
  id                   String       @id @default(cuid())
  originalTestID       String       @unique @map("original_test_id")
  name                 String
  metadata             Json
  architecture         Architecture
  target               Json?
  createdAt            DateTime     @map("created_at")
  updatedAt            DateTime     @map("updated_at")
  archivedAt           DateTime     @default(now()) @map("archived_at")
  organizationID       String       @map("organization_id")
  folderID             String?      @map("folder_id")
  applicationVersionID String       @map("application_version_id")
  testGroupid          String       @map("test_group_id")
  userID               String?      @map("user_id")
  archivedByUserID     String       @map("archived_by_user_id")
  type                 TestType     @map("type")

  organization Organization @relation(fields: [organizationID], references: [id])
  archivedBy   User         @relation(fields: [archivedByUserID], references: [id])

  @@index([organizationID])
  @@index([archivedAt])
  @@map("archived_test")
}

model Component {
  id                String                       @id @default(cuid())
  name              String
  architecture      Architecture
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  organizationId    String                       @map("organization_id")
  organization      Organization                 @relation(fields: [organizationId], references: [id])
  folderId          String                       @map("folder_id")
  folder            Folder                       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId            String                       @map("user_id")
  user              User                         @relation(fields: [userId], references: [id])
  defaultVersionId  String                       @map("default_version_id")
  defaultVersion    ComponentVersion             @relation("DefaultVersion", fields: [defaultVersionId], references: [id])
  applicationId     String                       @map("application_id")
  application       Application                  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignments       ComponentVersionAssignment[]
  mirrorPairsA      ComponentMirrorPair[]        @relation("MirrorComponentA")
  mirrorPairsB      ComponentMirrorPair[]        @relation("MirrorComponentB")
  componentVersions ComponentVersion[]

  @@index([organizationId])
  @@index([folderId])
  @@index([name])
  @@index([name, organizationId])
  @@index([createdAt])
  @@index([userId])
  @@map("component")
}

model ComponentVersion {
  id                  String                       @id @default(cuid())
  name                String
  createdAt           DateTime                     @default(now()) @map("created_at")
  organizationId      String                       @map("organization_id")
  organization        Organization                 @relation(fields: [organizationId], references: [id])
  componentId         String                       @map("component_id")
  component           Component                    @relation(fields: [componentId], references: [id], onDelete: Cascade)
  userId              String?                      @map("user_id")
  user                User?                        @relation(fields: [userId], references: [id])
  prefixSequenceId    String?                      @map("prefix_sequence_id")
  prefixSequence      StepSequence?                @relation("PrefixStepSequence", fields: [prefixSequenceId], references: [id], onDelete: Cascade)
  executionSequenceId String?                      @map("execution_sequence_id")
  executionSequence   StepSequence?                @relation("ExecutionStepSequence", fields: [executionSequenceId], references: [id], onDelete: Cascade)
  parameters          Json? /// JSON object mapping parameter names to their definitions: { [name]: { defaultValue: string } }
  bindsVariables      String[]                     @default([]) @map("binds_variables") /// Variable keys that this component creates during execution
  defaultIn           Component[]                  @relation("DefaultVersion")
  mirrorPairsA        ComponentVersionMirrorPair[] @relation("MirrorComponentVersionA")
  mirrorPairsB        ComponentVersionMirrorPair[] @relation("MirrorComponentVersionB")
  versionAssignments  ComponentVersionAssignment[]

  @@index([organizationId])
  @@index([createdAt])
  @@map("component_version")
}

model ComponentVersionAssignment {
  id                   String             @id @default(cuid())
  applicationVersionId String             @map("application_version_id")
  componentId          String             @map("component_id")
  componentVersionId   String             @map("component_version_id")
  applicationVersion   ApplicationVersion @relation(fields: [applicationVersionId], references: [id], onDelete: Cascade)
  componentVersion     ComponentVersion   @relation(fields: [componentVersionId], references: [id], onDelete: Cascade)
  component            Component          @relation(fields: [componentId], references: [id])

  @@unique([applicationVersionId, componentId])
  @@index([componentVersionId])
  @@map("component_version_assignment")
}

model ComponentMirrorPair {
  id                    String                       @id @default(cuid())
  appMirrorPairID       String                       @map("app_mirror_pair_id")
  componentIdA          String                       @map("component_id_a")
  componentIdB          String                       @map("component_id_b")
  createdBy             String?                      @map("created_by")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  componentA            Component                    @relation("MirrorComponentA", fields: [componentIdA], references: [id], onDelete: Cascade)
  componentB            Component                    @relation("MirrorComponentB", fields: [componentIdB], references: [id], onDelete: Cascade)
  appMirrorPair         AppMirrorPair                @relation(fields: [appMirrorPairID], references: [id], onDelete: Cascade)
  componentVersionPairs ComponentVersionMirrorPair[]

  @@unique([appMirrorPairID, componentIdA, componentIdB])
  @@index([appMirrorPairID])
  @@index([componentIdA])
  @@index([componentIdB])
  @@map("component_mirror_pair")
}

model ComponentVersionMirrorPair {
  id                    String              @id @default(cuid())
  componentMirrorPairID String              @map("component_mirror_pair_id")
  componentVersionIdA   String              @map("component_version_id_a")
  componentVersionIdB   String              @map("component_version_id_b")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  componentMirrorPair   ComponentMirrorPair @relation(fields: [componentMirrorPairID], references: [id], onDelete: Cascade)
  componentVersionA     ComponentVersion    @relation("MirrorComponentVersionA", fields: [componentVersionIdA], references: [id], onDelete: Cascade)
  componentVersionB     ComponentVersion    @relation("MirrorComponentVersionB", fields: [componentVersionIdB], references: [id], onDelete: Cascade)

  @@unique([componentMirrorPairID, componentVersionIdA, componentVersionIdB])
  @@index([componentMirrorPairID])
  @@index([componentVersionIdA])
  @@index([componentVersionIdB])
  @@map("component_version_mirror_pair")
}

model StepSequence {
  id             String             @id @default(cuid())
  name           String
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organizationId String             @map("organization_id")
  organization   Organization       @relation(fields: [organizationId], references: [id])
  steps          TestStep[]
  prefixTo       ComponentVersion[] @relation("PrefixStepSequence")
  executionFor   ComponentVersion[] @relation("ExecutionStepSequence")

  @@index([organizationId])
  @@map("step_sequence")
}

model TestStep {
  id             String        @id @default(cuid())
  instruction    String
  interaction    String
  // For now, metadata still is a horrible Json field. In the future this NEEDS to change to a proper structured type.
  metadata       Json
  order          Int
  createdAt      DateTime      @default(now()) @map("created_at")
  stepSequenceId String?       @map("step_sequence_id")
  stepSequence   StepSequence? @relation(fields: [stepSequenceId], references: [id])

  @@map("test_step")
}

model VersionAssignment {
  id                   String             @id @default(cuid())
  applicationVersionID String             @map("application_version_id")
  testID               String             @map("test_id")
  testGroupID          String             @map("test_group_id")
  applicationVersion   ApplicationVersion @relation(fields: [applicationVersionID], references: [id], onDelete: Cascade)
  test                 Test               @relation(fields: [testID], references: [id], onDelete: Cascade)
  testGroup            TestGroup          @relation(fields: [testGroupID], references: [id], onDelete: Cascade)

  @@unique([applicationVersionID, testGroupID])
  @@index([testID])
  @@map("version_assignment")
}

model TestGroup {
  id             String                @id @default(cuid())
  name           String
  organizationID String
  organization   Organization          @relation(fields: [organizationID], references: [id])
  userID         String?               @map("user_id")
  user           User?                 @relation(fields: [userID], references: [id])
  applicationID  String?               @map("application_id")
  application    Application?          @relation(fields: [applicationID], references: [id])
  folderID       String?               @map("folder_id")
  architecture   Architecture
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  quarantined    Boolean               @default(false)
  tags           TagInTestGroup[]
  tests          Test[]                @relation("ParentTestGroup")
  runSchedules   RunSchedule[]
  folder         Folder?               @relation(fields: [folderID], references: [id])
  watches        Watch[]
  defaultTestId  String?               @map("default_test_id")
  defaultTest    Test?                 @relation("DefaultTest", fields: [defaultTestId], references: [id], onDelete: SetNull)
  assignments    VersionAssignment[]
  mirrorPairsA   TestGroupMirrorPair[] @relation("MirrorTestGroupA")
  mirrorPairsB   TestGroupMirrorPair[] @relation("MirrorTestGroupB")

  @@index([organizationID], name: "test_group_organization_id_idx")
  @@index([applicationID], name: "test_group_application_id_idx")
  @@index([folderID])
  @@index([quarantined])
  @@map("test_group")
}

model AppMirrorPair {
  id                   String                @id @default(cuid())
  organizationID       String                @map("organization_id")
  appIdA               String                @map("app_id_a")
  appIdB               String                @map("app_id_b")
  createdBy            String?               @map("created_by")
  metadata             Json?                 @default("{}") @db.Json
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  organization         Organization          @relation(fields: [organizationID], references: [id], onDelete: Cascade)
  appA                 Application           @relation("AppMirrorPairA", fields: [appIdA], references: [id], onDelete: Cascade)
  appB                 Application           @relation("AppMirrorPairB", fields: [appIdB], references: [id], onDelete: Cascade)
  testGroupPairs       TestGroupMirrorPair[]
  componentMirrorPairs ComponentMirrorPair[]

  @@unique([organizationID, appIdA, appIdB])
  @@index([organizationID, appIdA])
  @@index([organizationID, appIdB])
  @@map("app_mirror_pair")
}

model TestGroupMirrorPair {
  id              String           @id @default(cuid())
  appMirrorPairID String           @map("app_mirror_pair_id")
  testGroupIdA    String           @map("test_group_id_a")
  testGroupIdB    String           @map("test_group_id_b")
  createdBy       String?          @map("created_by")
  metadata        Json?            @default("{}") @db.Json
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  appMirrorPair   AppMirrorPair    @relation(fields: [appMirrorPairID], references: [id], onDelete: Cascade)
  testGroupA      TestGroup        @relation("MirrorTestGroupA", fields: [testGroupIdA], references: [id], onDelete: Cascade)
  testGroupB      TestGroup        @relation("MirrorTestGroupB", fields: [testGroupIdB], references: [id], onDelete: Cascade)
  testPairs       TestMirrorPair[]

  @@unique([appMirrorPairID, testGroupIdA, testGroupIdB])
  @@index([appMirrorPairID])
  @@index([testGroupIdA])
  @@index([testGroupIdB])
  @@map("test_group_mirror_pair")
}

model TestMirrorPair {
  id                    String              @id @default(cuid())
  testGroupMirrorPairID String              @map("test_group_mirror_pair_id")
  testIdA               String              @map("test_id_a")
  testIdB               String              @map("test_id_b")
  sourceTestType        TestType            @map("source_test_type")
  metadata              Json?               @default("{}") @db.Json
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  testGroupMirrorPair   TestGroupMirrorPair @relation(fields: [testGroupMirrorPairID], references: [id], onDelete: Cascade)
  testA                 Test                @relation("MirrorTestA", fields: [testIdA], references: [id], onDelete: Cascade)
  testB                 Test                @relation("MirrorTestB", fields: [testIdB], references: [id], onDelete: Cascade)

  @@unique([testGroupMirrorPairID, testIdA, testIdB])
  @@index([testGroupMirrorPairID])
  @@index([testIdA])
  @@index([testIdB])
  @@map("test_mirror_pair")
}

model Run {
  id              String       @id @default(cuid())
  videoURL        String?      @map("video_url")
  appiumLogsURL   String?      @map("appium_logs_url")
  deviceLogsURL   String?      @map("device_logs_url")
  networkLogsURL  String?      @map("network_logs_url")
  tcpDumpLogsURL  String?      @map("tcp_dump_logs_url")
  name            String
  createdAt       DateTime     @default(now()) @map("created_at")
  startedAt       DateTime?    @map("started_at")
  endedAt         DateTime?    @map("ended_at")
  organizationID  String       @map("organization_id")
  testSuiteRunID  String?
  organization    Organization @relation(fields: [organizationID], references: [id])
  steps           Step[]
  status          StepStatus? // TODO: Make it non-optional
  folderID        String?      @map("folder_id")
  folder          Folder?      @relation(fields: [folderID], references: [id], onDelete: Cascade)
  tagIDs          String[]     @default([]) @map("tag_ids")
  tagID           String?      @map("tag_id")
  tag             Tag?         @relation(fields: [tagID], references: [id], onDelete: Cascade)
  folderRunID     String?      @map("folder_run_id")
  testID          String?      @map("test_id")
  test            Test?        @relation(fields: [testID], references: [id], onDelete: SetNull)
  jobId           String?      @map("job_id")
  jobRunId        String?      @map("job_run_id")
  /// [RuntimeMetadata]
  runtimeMetadata Json?        @map("runtime_metadata")
  regeneration    Boolean?     @map("regeneration")
  retries         Int?
  runGroupID      String?      @map("run_group_id")

  runGroup      RunGroup?     @relation(fields: [runGroupID], references: [id], onDelete: Cascade)
  scheduledRuns RunSchedule[]
  runMetadata   RunMetadata?  @relation("RunToRunMetadata")
  testReview    TestReview?
  aiUsage       AiUsage[]
  accessibilityReports AccessibilityReport[]
  deviceFarmBilling    DeviceFarmBilling?

  @@index([createdAt])
  @@index([organizationID])
  @@index([folderID])
  @@index([testID])
  @@index([runGroupID])
  @@index([folderRunID])
  @@index([organizationID, createdAt(sort: Desc)], map: "run_org_id_created_at_desc_idx")
  @@map("run")
}

model RunGroup {
  id                 String     @id @default(cuid())
  status             StepStatus @default(pending)
  notified           Boolean    @default(false)
  conciliationReason String?    @map("conciliation_reason")

  runs Run[]

  @@map("run_group")
}

enum SourceType {
  SCHEDULED
  MANUAL
  API
  CI_CD
  VERCEL

  @@map("source_type")
}

model RunMetadata {
  id         String     @id @default(cuid())
  runId      String     @unique @map("run_id")
  source     SourceType @default(API)
  dynamicUrl String?    @map("dynamic_url")
  userImage  String?    @map("user_image")
  username   String?
  email      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  rerunAt    DateTime?  @map("rerun_at")

  run Run @relation("RunToRunMetadata", fields: [runId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([username])
  @@index([source])
  @@map("run_metadata")
}

model RunSchedule {
  id                    String           @id @default(cuid())
  crontab               String
  type                  SchedulerJobType @default(test)
  enabled               Boolean          @default(true)
  folderID              String?          @map("folder_id")
  folder                Folder?          @relation(fields: [folderID], references: [id], onDelete: Cascade)
  testGroupID           String?          @map("test_group_id")
  testGroup             TestGroup?       @relation(fields: [testGroupID], references: [id], onDelete: Cascade)
  tagID                 String?          @map("tag_id")
  tag                   Tag?             @relation(fields: [tagID], references: [id], onDelete: Cascade)
  lastRunID             String?          @map("last_run_id")
  lastRun               Run?             @relation(fields: [lastRunID], references: [id], onDelete: SetNull)
  lastFolderRunID       String?          @map("last_folder_run_id")
  applicationVersionIDs String[]         @default([]) @map("application_version_ids")
  createdAt             DateTime         @default(now()) @map("created_at")
