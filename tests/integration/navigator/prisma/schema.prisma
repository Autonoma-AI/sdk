  vercelTeamName  String?      @map("vercel_team_name")
  configurationId String       @map("configuration_id")
  linkedByUserId  String       @map("linked_by_user_id")
  linkedByUser    User         @relation(fields: [linkedByUserId], references: [id])
  linkedAt        DateTime     @default(now()) @map("linked_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, vercelTeamId])
  @@index([vercelTeamId])
  @@index([configurationId])
  @@map("vercel_sso_link")
}

model VercelCheck {
  id                  String   @id @default(cuid())
  vercelCheckId       String   @unique @map("vercel_check_id")
  projectConnectionId String   @map("project_connection_id")
  installationId      String   @map("installation_id")
  name                String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  projectConnection VercelProjectConnection @relation(fields: [projectConnectionId], references: [id], onDelete: Cascade)
  installation      VercelInstallation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  targets           VercelCheckTarget[]

  @@index([installationId])
  @@index([projectConnectionId])
  @@map("vercel_check")
}

model VercelCheckTarget {
  id              String   @id @default(cuid())
  checkId         String   @map("check_id")
  targetMappingId String   @map("target_mapping_id")
  createdAt       DateTime @default(now()) @map("created_at")

  check         VercelCheck         @relation(fields: [checkId], references: [id], onDelete: Cascade)
  targetMapping VercelTargetMapping @relation(fields: [targetMappingId], references: [id], onDelete: Cascade)

  @@unique([checkId, targetMappingId])
  @@index([checkId])
  @@index([targetMappingId])
  @@map("vercel_check_target")
}

enum AnnouncementType {
  BANNER
  CARD

  @@map("announcement_type")
}

enum AnnouncementBannerType {
  INFO
  ALERT
  ERROR

  @@map("announcement_banner_type")
}

enum StickinessEmailType {
  no_tests
  has_drafts
  saved_not_run
  low_quota
  first_run

  @@map("stickiness_email_type")
}

model Announcement {
  id         String                  @id @default(cuid())
  title      String?
  subtitle   String?
  imageUrl   String?                 @map("image_url")
  text       String?
  cta        String?
  ctaUrl     String?                 @map("cta_url")
  bannerType AnnouncementBannerType? @map("banner_type")
  enabled    Boolean                 @default(true)
  type       AnnouncementType        @default(CARD)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("announcement")
}

model TestReview {
  id    String @id @default(cuid())
  runId String @unique @map("run_id")
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  faultType  FaultType @map("fault_type")
  confidence Float
  actionable Boolean? // Si el summary es actionable

  classification Json @db.Json
  summary        Json @db.Json

  // Metadata
  reviewedAt DateTime         @default(now()) @map("reviewed_at")
  reviewedBy String           @map("reviewed_by")
  status     TestReviewStatus @default(completed)
  error      String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([runId])
  @@index([reviewedAt])
  @@index([status])
  @@index([faultType])
  @@map("test_review")
}

model AiUsage {
  id             String       @id @default(cuid())
  runId          String       @map("run_id")
  organizationId String       @map("organization_id")
  architecture   Architecture
  createdAt      DateTime     @default(now()) @map("created_at")
  modelId        String       @map("model_id")
  provider       String
  modelName      String       @map("model_name")
  inputTokens    Int          @map("input_tokens")
  outputTokens   Int          @map("output_tokens")
  cost           Decimal      @db.Decimal(10, 6)
  /// [AiUsageDetails]
  details        Json?

  run          Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([organizationId])
  @@index([architecture])
  @@index([createdAt])
  @@index([modelId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("ai_usage")
}

model QuaraConversation {
  id             String       @id @default(cuid())
  conversationId String       @unique @map("conversation_id")
  organizationID String       @map("organization_id")
  userID         String       @map("user_id")

  prompt         String
  architecture   Architecture
  target         String

  /// [QuaraConversationMessages]
  messages        Json     @default("[]") @db.Json
  /// [QuaraConversationSteps]
  steps           Json     @default("[]") @db.Json
  /// [QuaraConversationStepExecutions]
  stepExecutions  Json     @default("[]") @map("step_executions") @db.Json
  /// [QuaraConversationExecutionResult]
  executionResult Json?    @map("execution_result") @db.Json

  status String @default("started")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@index([organizationID])
  @@index([userID])
  @@index([conversationId])
  @@map("quara_conversation")
}
